@model Sunlight.Framework.UI.Test.RazorTestVM
<div><div data-test="rows">@foreach (var i in Model.Items) { <div data-test="row"><span data-test="row-before">Agent · @i.Name</span><span data-test="row-after">@i.Name units</span><span data-test="row-both">@i.Name @i.Name</span><span data-test="row-layout">
