<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TargetPlatform>x64</TargetPlatform>
    <TargetFrameworkVersion>net8.0</TargetFrameworkVersion>
  </RunConfiguration>
  <NSTest>
    <!--
      DLL holding the [TestFixture]/[Test] attributed types we want to discover.
      Resolved relative to the wrapper's bin/ at runtime — the wrapper's csproj
      copies Sunlight.Framework.Test.dll alongside its own output.
    -->
    <TestSourceAssembly>Sunlight.Framework.Test.dll</TestSourceAssembly>

    <!--
      NScript-emitted JavaScript bundle that QUnit executes inside Chromium.
      Resolved against the test DLL directory first (the wrapper's bin), then CWD.
      The framework test project emits to ../TestWebApplication/GeneratedScripts/
      relative to its own bin, so we walk up to reach it.
    -->
    <JsFilePath>../../../../TestWebApplication/GeneratedScripts/Sunlight.Framework.Test.js</JsFilePath>
  </NSTest>
</RunSettings>
