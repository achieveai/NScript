    <RazorProbeControl data-test="ha-bound" data-x="@Model.Label" aria-label="@Model.Label" id="@Model.HostId" />
    @foreach (var row in Model.Rows)
    {
        <RazorProbeControl data-test="ha-row" data-name="@row.Name" />
    }
</div>
