@model TodoApp.ViewModels.AppViewModel

<div data-test="1">
    <div class="@(Model.IsLeftPaneCollapsed ? "pane-left collapsed" : "pane-left")">
        <div class="pane-header">
            <div class="app-title">To Do</div>
        </div>
        <div class="folder-list">
            @foreach (var folder in Model.Folders)
            {
                <div class="@(folder.IsSelected ? "folder-item selected" : "folder-item")" onclick="@folder.OnSelect">
                    <div class="folder-icon">@folder.Icon</div>
                    <div class="folder-name">@folder.Name</div>
                    <div class="folder-count">@folder.TodoCount</div>
                </div>
            }
        </div>
    </div>
    <div class="pane-center">
        <div class="pane-header">
            <div class="btn-toggle-left" onclick="@Model.ToggleLeftPane">&#9776;</div>
            <div class="current-folder-name">@Model.SelectedFolderName</div>
        </div>
        <div class="todo-list">
            @foreach (var todo in Model.CurrentTodos)
            {
                <div class="@(todo.IsCompleted ? "todo-item completed" : "todo-item")" onclick="@Model.OnSelectTodo(todo)">
                    <div class="todo-check" onclick="@todo.ToggleComplete">&#10003;</div>
                    <div class="todo-title">@todo.Title</div>
                    <div class="@(todo.IsImportant ? "star important" : "star")" onclick="@todo.ToggleImportant">@(todo.IsImportant ? "★" : "☆")</div>
                </div>
            }
        </div>
        <div class="add-todo-bar">
            <div class="add-icon">+</div>
            <input type="text" class="add-task-input" placeholder="Add a task" onkeydown="@Model.AddTodoOnEnter" />
        </div>
    </div>
    <div class="@(Model.IsRightPaneCollapsed ? "pane-right collapsed" : "pane-right")">
        <div class="pane-header">
            <div class="btn-close-detail" onclick="@Model.ToggleRightPane">&#10005;</div>
        </div>
        <div class="task-detail">
            <div class="detail-title">@Model.DetailTitle</div>
            <div class="detail-section">
                <div class="section-label">Subtasks</div>
                <div class="add-subtask" onclick="@Model.AddSubTaskToSelected">
                    <div class="add-icon">+</div>
                    <div>Add step</div>
                </div>
            </div>
            <div class="detail-section delete-section" onclick="@Model.DeleteSelectedTodo">
                <div class="section-icon">&#128465;</div>
                <div>Delete task</div>
            </div>
        </div>
    </div>
</div>
