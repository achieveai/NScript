<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(CompilerNetFramework)</TargetFramework>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <ProduceReferenceAssemblies>false</ProduceReferenceAssemblies>
    <PackAsTool>true</PackAsTool>
    <PackageOutputPath>$(NScriptToolsetDir)</PackageOutputPath>
    <PackageId>Mcqdb.NScript.Cs2Jsc</PackageId>
    <!--
      Pinned ahead of $(NScriptPackageVersion). History:
        1.1.0 — shipped a Windows-argv handling bug
                (BuildClient.GetCommandLineWindows leaked Cs2Jsc.dll + the
                `csc` subcommand selector into Roslyn's argv under dotnet-tool
                hosting, breaking every MSBuild client).
        1.1.1 — fix for the argv bug, BUT was packed from a polluted bin/
                that contained mixed 7.1.4 / 7.5.0 ClearScript binaries.
                Native V8 7.5 + ICUData 7.5.0.0 from prior solution state
                leaked in alongside the explicit 7.1.4 managed wrapper,
                causing V8Proxy.InitializeICU() to fail at runtime.
        1.1.2 — packed from a clean build; all ClearScript binaries are
                consistent 7.1.4 (V8.dll + native runtimes + ICU.dat data
                file via the 7.1.4 ICUData package's props).
        1.1.3 — ClearScript bumped from 7.1.4 (June 2021) to 7.5.1, the
                latest stable. ICU now ships as an assembly
                (ClearScript.V8.ICUData.dll, ~10MB) instead of a loose
                ClearScriptV8.ICU.dat file. Native V8 runtimes grow from
                ~15MB to ~26MB (win-x64) because V8 itself is newer.
      The rest of the toolset stays at 1.1.0 — version bumps and bugs were
      isolated to the compiler tool.
    -->
    <PackageVersion>1.1.6</PackageVersion>
    <GeneratePackageOnBuild>$(GenerateNScriptPackages)</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NScript.Lib\NScript.Lib.csproj" />
    <ProjectReference Include="..\NScript.Csc.Lib\NScript.Csc.Lib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="PluginConfig.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.4.0" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.4.0" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.4.0" />
  </ItemGroup>
</Project>
