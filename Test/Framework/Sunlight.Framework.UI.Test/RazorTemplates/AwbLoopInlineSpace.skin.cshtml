@model Sunlight.Framework.UI.Test.RazorTestVM
<div><div data-test="rows">@foreach (var i in Model.Items) { <div data-test="row"><span data-test="row-before">Agent · @i.Name</span><span data-test="row-after">@i.Name units</span><span data-test="row-both">@i.Name @i.Name</span><span data-test="row-tab">@i.Name	@i.Name</span><span data-test="row-layout">
    @i.Name
</span><span data-test="row-nested"><i>in</i>@foreach (var inner in Model.Items) { <b data-test="nested">Agent · @inner.Name</b> }</span></div> }</div>@if (Model.IsActive) { <span data-test="if-before">Agent · @Model.Name</span><span data-test="if-after">@Model.Name units</span><span data-test="if-both">@Model.Name @Model.Name</span><span data-test="if-spaces">@Model.Name   @Model.Name</span><span data-test="if-layout">
    @Model.Name
</span> } else { <span data-test="else-before">Agent · @Model.Name</span><span data-test="else-after">@Model.Name units</span><span data-test="else-both">@Model.Name @Model.Name</span> }</div>
