@model Sunlight.Framework.UI.Test.SlotHostVM

<div data-test="slot-named">
    <SlotPanel DataContext="@Model.Frame">
        <Slot Name="head"><h2 class="head">@Model.Message</h2></Slot>
        <p class="msg">@Model.Message</p>
        <Slot Name="actions"><button class="confirm" onclick="@Model.Confirm">ok</button></Slot>
    </SlotPanel>
</div>
